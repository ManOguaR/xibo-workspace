{
  "name": "xibo-modules",
  "version": "1.0.0-dev.6",
  "description": "Xibo 4.4.x module authoring SDK and local development CLI",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "bin": {
    "xibo": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "src/developer/xibo-player/",
    "templates/",
    "LICENSES/",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "rebuild": "npm run clean && npm run build",
    "prepack": "npm run build && node scripts/prepare-license.mjs"
  },
  "keywords": [
    "xibo",
    "digital-signage",
    "sdk"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/jquery": "^4.0.1",
    "fast-xml-parser": "^5.11.1",
    "fast-xml-validator": "^1.4.2",
    "tsx": "^4.23.13",
    "twing": "^7.3.1",
    "vite": "^8.3.0"
  }
}
